# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional second provider (https://openrouter.ai/keys). When one provider is rate-limited
# or failing, requests fail over to the next; live frames alternate between them.
# Paid OpenRouter models need account credits; a 3-minute live demo costs well under $0.01.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_VISION_MODEL=qwen/qwen3.8-27b  # ~2 s; google/gemini-3.1-flash-lite measured 1.2-2.4 s
PROVIDER_ORDER=groq,openrouter

# Where camera frames are analysed: "cloud" (the providers above) or "ollama" (local GPU,
# no quota, frames never leave this machine).
VISION_PROVIDER=cloud
OLLAMA_URL=http://localhost:11434
# Must fit in VRAM. On a 6 GB card: qwen3.5:4b, gemma3:4b or gemma4:e2b-it-qat.
# Plain "gemma4" is the ~9.6 GB E4B build and will NOT fit in 6 GB.
OLLAMA_VISION_MODEL=qwen3.5:4b

# Used only if DB_HOST (below) is unset. Default for local dev without a cloud DB.
DATABASE_URL=sqlite:///sight.db

# TiDB Cloud (or any MySQL-compatible) connection. Setting DB_HOST switches the app
# to this DB instead of sqlite. Get these from TiDB Cloud console > Connect.
# NOTE: a "Private Endpoint" hostname (contains "privatelink") only resolves inside
# the matching AWS VPC - use the "Public Endpoint" connection type for a laptop/dev box.
# NOTE: don't point DB_DATABASE at "sys" - that's TiDB's reserved system schema.
# Create a dedicated database (e.g. "sight") in the console or with
# `CREATE DATABASE sight;` and use that name here.
DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=sight
